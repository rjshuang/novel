{
    "proxy_pool": [],
    "rules": [
        {
            "endpoint": "https://www.22biqu.com",
            "search": {
                "uri": "/ss",
                "method": "POST",
                "header": {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "params": {
                    "Submit": "搜索",
                    "searchkey": "?"
                }
            },
            "book": {
                "path": "//div[@class='row']/div/ul/li",
                "detail": {
                    "name": "//span[1]/a",
                    "uri": "//span[1]/a[@href]",
                    "img_uri": "",
                    "author": "//span[3]",
                    "last_chapter": "//span[2]/a",
                    "last_update": "//span[4]",
                    "description": ""
                }
            },
            "chapter": {
                "path": "//div[@class='section-box' 1]/ul/li/a",
                "page": {
                    "path": "//a[@class='index-container-btn']",
                    "pattern": "下一页"
                }
            },
            "content": {
                "path": "//div[@id='content']",
                "page": {
                    "path": "//a[@id='next_url']",
                    "pattern": "下一页"
                }
            }
        },
        {
            "endpoint": "https://www.beqege.net",
            "search": {
                "uri": "/search.php",
                "method": "GET",
                "header": {},
                "params": {
                    "q": "?"
                }
            },
            "book": {
                "path": "//div[@class='col-12 col-md-6']",
                "detail": {
                    "name": "//dt/a/img[@alt]",
                    "uri": "//dt/a[@href]",
                    "img_uri": "//dt/img[@src]",
                    "author": "//dd/span",
                    "last_chapter": "//dd/a",
                    "last_update": "//dd[3]",
                    "description": ""
                }
            },
            "chapter": {
                "path": "//div[@class='book_list book_list2']/ul/li/a",
                "page": {
                    "path": "//div[@class='pages']/ul/li/a",
                    "pattern": "index_%d.html"
                }
            },
            "content": {
                "path": "//article",
                "page": {
                    "path": "//div/a[@id='next']",
                    "pattern": "下一章"
                }
            }
        },
        {
            "endpoint": "https://www.luoxia123.com",
            "search": {
                "uri": "/e/search/index.php",
                "method": "POST",
                "header": {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "params": {
                    "tbname": "bookname",
                    "show": "title,writer",
                    "tempid": "1",
                    "keyboard": "?"
                }
            },
            "book": {
                "path": "//table/tbody/tr",
                "detail": {
                    "name": "//td[0]/a[@title]",
                    "uri": "//td[0]/a[@href]",
                    "img_uri": "",
                    "author": "//td[2]",
                    "last_chapter": "//td[1]/a",
                    "last_update": "//td[3]",
                    "description": ""
                }
            },
            "chapter": {
                "path": "//div[@class='panel panel-danger m-cover']/ul/li/a",
                "page": {
                    "path": "",
                    "pattern": ""
                }
            },
            "content": {
                "path": "//div[@id='content']",
                "page": {
                    "path": "//div[@class='m-page']/a[2]",
                    "pattern": "下一章"
                }
            }
        },
        {
            "rate_limit": true,
            "endpoint": "https://www.ddxsmf.com",
            "search": {
                "uri": "",
                "method": "GET",
                "header": {},
                "params": {}
            },
            "book": {
                "path": "//head",
                "detail": {
                    "name": "//meta[@property='og:novel:book_name' @content]",
                    "uri": "//meta[@property='og:novel:read_url' @content]",
                    "img_uri": "//meta[@property='og:image' @content]",
                    "author": "//meta[@property='og:novel:author' @content]",
                    "last_chapter": "//meta[@property='og:novel:latest_chapter_name' @content]",
                    "last_update": "//meta[@property='og:novel:update_time' @content]",
                    "description": "//meta[@property='og:description' @content]"
                }
            },
            "chapter": {
                "path": "//div[@class='qustime' 1]/ul/ul/li/a",
                "title": "//span",
                "page": {
                    "path": "//em[@id='pagestats']",
                    "pattern": "%d"
                }
            },
            "content": {
                "path": "//div[@class='txtnav']",
                "page": {
                    "path": "",
                    "pattern": ""
                }
            }
        }
    ]
}
